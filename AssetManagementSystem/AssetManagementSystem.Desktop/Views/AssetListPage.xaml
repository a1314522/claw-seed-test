<UserControl x:Class="AssetManagementSystem.Desktop.Views.AssetListPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:AssetManagementSystem.Desktop.ViewModels"
             Background="{DynamicResource BackgroundBrush}">
    <UserControl.DataContext>
        <vm:AssetListViewModel/>
    </UserControl.DataContext>
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="资产卡片管理" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource ForegroundBrush}" Margin="0,0,0,16"/>

        <Grid Grid.Row="1" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Orientation="Horizontal">
                <TextBox Width="240" Height="36" VerticalContentAlignment="Center" Margin="0,0,8,0"
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" 
                         Style="{StaticResource SearchTextBoxStyle}"/>
                <Button Content="🔍 搜索" Command="{Binding SearchCommand}" Style="{StaticResource PrimaryButtonStyle}"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="➕ 新增资产" Command="{Binding AddAssetCommand}" Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,8,0"/>
                <Button Content="📥 导入" Command="{Binding ImportCommand}" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0"/>
                <Button Content="📤 导出" Command="{Binding ExportCommand}" Style="{StaticResource SecondaryButtonStyle}"/>
            </StackPanel>
        </Grid>

        <Border Grid.Row="2" Style="{StaticResource CardStyle}">
            <DataGrid ItemsSource="{Binding Assets}" AutoGenerateColumns="False" IsReadOnly="True"
                      GridLinesVisibility="Horizontal" BorderThickness="0" Background="Transparent">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="资产编号" Binding="{Binding AssetCode}" Width="120"/>
                    <DataGridTextColumn Header="资产名称" Binding="{Binding Name}" Width="200"/>
                    <DataGridTextColumn Header="分类" Binding="{Binding CategoryName}" Width="120"/>
                    <DataGridTextColumn Header="规格型号" Binding="{Binding Model}" Width="140"/>
                    <DataGridTextColumn Header="使用部门" Binding="{Binding Department}" Width="120"/>
                    <DataGridTextColumn Header="责任人" Binding="{Binding ResponsiblePerson}" Width="100"/>
                    <DataGridTextColumn Header="状态" Binding="{Binding Status}" Width="100"/>
                    <DataGridTextColumn Header="购入日期" Binding="{Binding PurchaseDate, StringFormat=d}" Width="120"/>
                    <DataGridTextColumn Header="原值" Binding="{Binding OriginalValue, StringFormat=C}" Width="120"/>
                    <DataGridTemplateColumn Header="操作" Width="120">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="✏️" Style="{StaticResource IconButtonStyle}" 
                                            Command="{Binding DataContext.EditAssetCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            CommandParameter="{Binding}"/>
                                    <Button Content="🗑️" Style="{StaticResource IconButtonStyle}" Margin="4,0,0,0"
                                            Command="{Binding DataContext.DeleteAssetCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            CommandParameter="{Binding}"/>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</UserControl>