<UserControl x:Class="AssetManagementSystem.Desktop.Views.AssetEditPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:AssetManagementSystem.Desktop.ViewModels"
             Background="{DynamicResource BackgroundBrush}">
    <UserControl.DataContext>
        <vm:AssetEditViewModel/>
    </UserControl.DataContext>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24" MaxWidth="800">
            <TextBlock Text="{Binding PageTitle}" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource ForegroundBrush}" Margin="0,0,0,24"/>

            <Border Style="{StaticResource CardStyle}" Padding="24">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,12,12">
                        <TextBlock Text="资产编号 *" Margin="0,0,0,4" Foreground="{DynamicResource MutedBrush}"/>
                        <TextBox Text="{Binding Asset.AssetCode}" Style="{StaticResource DefaultTextBoxStyle}"/>
                    </StackPanel>
                    <StackPanel Grid.Row="0" Grid.Column="1" Margin="12,0,0,12">
                        <TextBlock Text="资产名称 *" Margin="0,0,0,4" Foreground="{DynamicResource MutedBrush}"/>
                        <TextBox Text="{Binding Asset.Name}" Style="{StaticResource DefaultTextBoxStyle}"/>
                    </StackPanel>

                    <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,12,12">
                        <TextBlock Text="分类" Margin="0,0,0,4" Foreground="{DynamicResource MutedBrush}"/>
                        <ComboBox ItemsSource="{Binding Categories}" SelectedValue="{Binding Asset.CategoryId}" 
                                  SelectedValuePath="Id" DisplayMemberPath="Name" Style="{StaticResource DefaultComboBoxStyle}"/>
                    </StackPanel>
                    <StackPanel Grid.Row="1" Grid.Column="1" Margin="12,0,0,12">
                        <TextBlock Text="状态" Margin="0,0,0,4" Foreground="{DynamicResource MutedBrush}"/>
                        <ComboBox ItemsSource="{Binding StatusOptions}" SelectedItem="{Binding Asset.Status}" Style="{StaticResource DefaultComboBoxStyle}"/>
                    </StackPanel>

                    <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,0,12,12">
                        <TextBlock Text="规格型号" Margin="0,0,0,4" Foreground="{DynamicResource MutedBrush}"/>
                        <TextBox Text="{Binding Asset.Model}" Style="{StaticResource DefaultTextBoxStyle}"/>
                    </StackPanel>
                    <StackPanel Grid.Row="2" Grid.Column="1" Margin="12,0,0,12">
                        <TextBlock Text="序列号" Margin="0,0,0,4" Foreground="{DynamicResource MutedBrush}"/>
                        <TextBox Text="{Binding Asset.SerialNumber}" Style="{StaticResource DefaultTextBoxStyle}"/>
                    </StackPanel>

                    <StackPanel Grid.Row="3" Grid.Column="0" Margin="0,0,12,12">
                        <TextBlock Text="使用部门" Margin="0,0,0,4" Foreground="{DynamicResource MutedBrush}"/>
                        <TextBox Text="{Binding Asset.Department}" Style="{StaticResource DefaultTextBoxStyle}"/>
                    </StackPanel>
                    <StackPanel Grid.Row="3" Grid.Column="1" Margin="12,0,0,12">
                        <TextBlock Text="责任人" Margin="0,0,0,4" Foreground="{DynamicResource MutedBrush}"/>
                        <TextBox Text="{Binding Asset.Owner}" Style="{StaticResource DefaultTextBoxStyle}"/>
                    </StackPanel>

                    <StackPanel Grid.Row="4" Grid.Column="0" Margin="0,0,12,12">
                        <TextBlock Text="存放位置" Margin="0,0,0,4" Foreground="{DynamicResource MutedBrush}"/>
                        <TextBox Text="{Binding Asset.Location}" Style="{StaticResource DefaultTextBoxStyle}"/>
                    </StackPanel>
                    <StackPanel Grid.Row="4" Grid.Column="1" Margin="12,0,0,12">
                        <TextBlock Text="购入日期" Margin="0,0,0,4" Foreground="{DynamicResource MutedBrush}"/>
                        <DatePicker SelectedDate="{Binding Asset.PurchaseDate}" Style="{StaticResource DefaultDatePickerStyle}"/>
                    </StackPanel>

                    <StackPanel Grid.Row="5" Grid.Column="0" Margin="0,0,12,12">
                        <TextBlock Text="原值（元）" Margin="0,0,0,4" Foreground="{DynamicResource MutedBrush}"/>
                        <TextBox Text="{Binding Asset.PurchasePrice}" Style="{StaticResource DefaultTextBoxStyle}"/>
                    </StackPanel>
                    <StackPanel Grid.Row="5" Grid.Column="1" Margin="12,0,0,12">
                        <TextBlock Text="供应商" Margin="0,0,0,4" Foreground="{DynamicResource MutedBrush}"/>
                        <TextBox Text="{Binding Asset.Supplier}" Style="{StaticResource DefaultTextBoxStyle}"/>
                    </StackPanel>

                    <StackPanel Grid.Row="6" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,0,0,12">
                        <TextBlock Text="备注" Margin="0,0,0,4" Foreground="{DynamicResource MutedBrush}"/>
                        <TextBox Text="{Binding Asset.Notes}" Height="80" TextWrapping="Wrap" AcceptsReturn="True" Style="{StaticResource DefaultTextBoxStyle}"/>
                    </StackPanel>

                    <StackPanel Grid.Row="7" Grid.Column="0" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="保存" Command="{Binding SaveCommand}" Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,8,0"/>
                        <Button Content="取消" Command="{Binding GoBackCommand}" Style="{StaticResource SecondaryButtonStyle}"/>
                    </StackPanel>
                </Grid>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>